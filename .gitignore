__pycache__/
*.pyc
pipes/live/
pipes/backup-*/
*.db
*.db-*
*.bak
*.bak-*
webui.db*

# eval run artifacts — baseline.json IS tracked, individual runs are not
tests/eval/results/

# reranker model cache (downloaded at runtime, ~2GB)
compose/infinity-cache/

# branding build input — the upstream Space Grotesk TTF, re-fetched on demand.
# The rendered assets/ and the subsetted fonts/ ARE tracked.
branding/.cache/

# searxng secret — rotated out of git 2026-07-29, lives here only
compose/.env

# GUEST_GROUP_ID, filled in by hand after bootstrap step 3 (docs/PUBLIC_INSTANCE.md) — not a
# secret, just per-install state that would be wrong on any other host
compose/public/.env

# ntfy runtime state — auth.db holds password/token hashes; never in git
compose/ntfy/

# identity-drift harness artifacts — generated PNGs, regenerate with tests/test_identity_drift.py
.identity-drift/

# deploy backups — copies of the previously-deployed function rows, kept for rollback
.deploy-backups/

# Claude Code local state — settings.local.json is machine-specific, and worktrees/
# holds full working copies of this repo (2+ MB of duplicate tree)
.claude/

# Flight recon: saved page bodies from scripts/flight_probe.py --save-html. Each is up to 512 KB of
# a third party's HTML, and there are 19 hosts x 2 tiers x 2 modes of them. The probe.json and
# findings.md ALONGSIDE them are the reviewable record and DO belong in git; the raw bodies are
# working material, and the ones worth keeping get trimmed into tests/fixtures/flights/ by hand.
docs/flight-recon/*/pages/
