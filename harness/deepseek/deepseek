#!/usr/bin/env bash
#
# deepseek -- launch Claude Code against a backend you can switch mid-session.
#
#   deepseek                    DeepSeek cloud API (default); no local traffic
#   deepseek --cloud            the same thing, kept for muscle memory
#   deepseek --local            local Qwen 3.8 on the RTX 3090
#   deepseek --model NAME       any routable model name
#   deepseek --status           router health and backend reachability
#   deepseek --routes [MODEL]   show which upstream a model resolves to
#   deepseek --restart          bounce the router
#
# Anything else is handed straight to claude, e.g.
#   deepseek --local -p "summarise this repo"
#   deepseek --continue
#
# The alias slots follow the main model's backend, so a cloud session never talks
# to the local models at all. 'opus' is always the cloud API. In a --local session
# 'sonnet' is the local Qwen -- the live /model switch -- 'haiku' is a fast local
# model for background work, and 'opus' is the way back out to the cloud.
#
set -euo pipefail

CONF_DIR="${HOME}/.config/deepseek"
ROUTER_PY="${CONF_DIR}/router.py"
CONFIG="${CONF_DIR}/router.json"
SECRETS="${CONF_DIR}/secrets.env"
LOGFILE="${XDG_CACHE_HOME:-$HOME/.cache}/deepseek-router.log"
UNIT="deepseek-router.service"

CLOUD_MODEL="${DEEPSEEK_CLOUD_MODEL:-deepseek-flash[1m]}"
LOCAL_MODEL="${DEEPSEEK_LOCAL_MODEL:-qwen38-coder:q4-128k}"
FAST_MODEL="${DEEPSEEK_FAST_MODEL:-gemma3:1b}"

die() { printf 'deepseek: %s\n' "$*" >&2; exit 1; }

[[ -r "$CONFIG" ]] || die "missing $CONFIG"
[[ -r "$ROUTER_PY" ]] || die "missing $ROUTER_PY"

read -r ROUTER_HOST ROUTER_PORT < <(
  jq -r '"\(.listen.host) \(.listen.port)"' "$CONFIG" 2>/dev/null \
    || echo "127.0.0.1 8788"
)
BASE_URL="http://${ROUTER_HOST}:${ROUTER_PORT}"

# A token is only needed for the cloud leg; the router passes it through verbatim.
#
# Precedence is DEEPSEEK_API_TOKEN, then ANTHROPIC_AUTH_TOKEN -- but note that
# secrets.env is SOURCED below, so it overwrites an ambient variable of the same
# name rather than losing to it. The file therefore wins over the shell, which is
# the opposite of what "environment beats file" intuition suggests. It only matters
# when both places set the same variable. On this host the token lives only in
# secrets.env (mode 600, DEEPSEEK_API_TOKEN); ~/.bashrc stopped exporting it on
# 2026-09-21, so the file is the sole source.
# shellcheck disable=SC1090
[[ -r "$SECRETS" ]] && source "$SECRETS"
AUTH_TOKEN="${DEEPSEEK_API_TOKEN:-${ANTHROPIC_AUTH_TOKEN:-}}"

router_up() { curl -sf -o /dev/null --max-time 2 "${BASE_URL}/v1/models"; }

start_router() {
  if systemctl --user list-unit-files "$UNIT" >/dev/null 2>&1 \
     && systemctl --user cat "$UNIT" >/dev/null 2>&1; then
    systemctl --user start "$UNIT"
  else
    mkdir -p "$(dirname "$LOGFILE")"
    nohup python3 "$ROUTER_PY" >>"$LOGFILE" 2>&1 &
    disown || true
  fi
  for _ in $(seq 1 40); do router_up && return 0; sleep 0.25; done
  die "router did not come up -- see ${LOGFILE} or: journalctl --user -u ${UNIT} -n 50"
}

ensure_router() { router_up || start_router; }

show_status() {
  if router_up; then
    printf 'router      up   %s\n' "$BASE_URL"
  else
    printf 'router      DOWN %s\n' "$BASE_URL"
  fi
  printf 'cloud       %s  (auth: %s)\n' "$CLOUD_MODEL" \
    "$([[ -n $AUTH_TOKEN ]] && echo present || echo MISSING)"
  printf 'local       %s\n' "$LOCAL_MODEL"
  printf 'fast        %s\n' "$FAST_MODEL"
  printf '\n'
  ensure_router
  printf '%-28s %s\n' "MODEL" "UPSTREAM"
  python3 "$ROUTER_PY" --route "$CLOUD_MODEL" "$LOCAL_MODEL" "$FAST_MODEL" \
    "qwen3.8:27b-q4_K_M" "hermes-genesis:agent" 2>/dev/null || true
}

case "${1:-}" in
  --status|-s) show_status; exit 0 ;;
  --routes)    shift; exec python3 "$ROUTER_PY" --route "${@:-$CLOUD_MODEL}" ;;
  --restart)
    if systemctl --user cat "$UNIT" >/dev/null 2>&1; then
      systemctl --user restart "$UNIT"
    else
      pkill -f "$ROUTER_PY" 2>/dev/null || true
      sleep 0.5
      start_router
    fi
    echo "router restarted on ${BASE_URL}"; exit 0 ;;
  --help|-h)
    # Print the header comment block (line 3 until the first non-comment line).
    # Deliberately not a hardcoded range: that silently truncates the help text
    # every time the header grows.
    awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$0"
    exit 0 ;;
esac

MODEL="$CLOUD_MODEL"
case "${1:-}" in
  --local)   MODEL="$LOCAL_MODEL"; shift ;;
  --cloud)   MODEL="$CLOUD_MODEL"; shift ;;
  --model)   [[ -n "${2:-}" ]] || die "--model needs a name"; MODEL="$2"; shift 2 ;;
esac

command -v claude >/dev/null 2>&1 || die "claude not found on PATH"
ensure_router

# Everything below keys off which upstream the chosen model resolves to, rather
# than off the --local/--cloud flags, so it stays right for `--model ANYTHING`
# and for a router.json that renames its providers.
CLOUD_PROVIDER="$(python3 "$ROUTER_PY" --provider "$CLOUD_MODEL" 2>/dev/null)"
PROVIDER="$(python3 "$ROUTER_PY" --provider "$MODEL" 2>/dev/null)"
[[ -n "$PROVIDER" ]] || die "router could not resolve a provider for '$MODEL'"

# A local backend needs two things spelled out that a cloud one doesn't: its real
# context window (Claude Code otherwise assumes 200k and over-fills the request,
# which a 32K model answers with an error) and no idle timeout (a 27B model can
# pause for minutes between chunks while it loads into VRAM). The window is read
# ONCE, at launch, so it is only safe to advertise the small one when the small
# model is what the session is actually on -- a cloud session keeps the window its
# model really has.
if [[ "$PROVIDER" != "$CLOUD_PROVIDER" ]]; then
  LOCAL_WINDOW="$(python3 "$ROUTER_PY" --window "$MODEL" 2>/dev/null)"
  if [[ -n "$LOCAL_WINDOW" ]]; then
    export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$LOCAL_WINDOW"
    # A 27B model can pause for minutes between chunks while loading into VRAM.
    export API_FORCE_IDLE_TIMEOUT=0
  fi
else
  # Unset rather than merely not setting. A cloud session launched from a shell
  # that already carries a local session's cap -- a nested shell, or Claude Code's
  # own Bash tool inside a --local session -- would otherwise inherit it and lose
  # most of the cloud model's window.
  unset CLAUDE_CODE_MAX_CONTEXT_TOKENS API_FORCE_IDLE_TIMEOUT
fi

# Override the ambient DeepSeek-cloud exports for this process only.
export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_AUTH_TOKEN="${AUTH_TOKEN:-router-local}"
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$CLOUD_MODEL"

# The alias slots are not spare copies of ANTHROPIC_MODEL: they are what Claude Code
# resolves its *other* traffic through -- background chores, session titles, the
# auto-mode classifier, subagents. Left pointing at the local tags in a cloud
# session they silently put all of it on the 3090 (measured 2026-09-24: 2.3k calls
# at a ~29k-token prefill each, GPU pinned at 99%, 383W, while the session model was
# cloud). So they follow the main model's provider. A cloud session then never
# touches the local backend at all; a local session keeps the live `/model sonnet`
# switch, with `opus` as the way back out to the cloud.
if [[ "$PROVIDER" == "$CLOUD_PROVIDER" ]]; then
  export ANTHROPIC_DEFAULT_SONNET_MODEL="$CLOUD_MODEL"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="$CLOUD_MODEL"
else
  export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="$FAST_MODEL"
fi

# --model is passed explicitly, not left to ANTHROPIC_MODEL above. Both paths end in
# the same binary reading the same ~/.claude/settings.json, and `model` there outranks
# the environment. A `/model` change in a stock `claude` session writes that key, and it
# would then launch this harness asking for a subscription model the router cannot route.
# The flag sits before "$@" so an explicit `deepseek --model NAME` still wins.
#
# Host-auth variables are dropped before exec, and this is a credential fix, not tidying.
# A shell spawned by Claude Desktop (its Bash tool, a subagent, an embedded terminal)
# carries CLAUDE_CODE_ENTRYPOINT=claude-desktop, and that one variable makes claude
# authenticate with the desktop app's claude.ai OAuth bearer instead of AUTH_TOKEN.
# The router forwards client auth verbatim, so the OAuth token went to api.deepseek.com:
# 11 requests on 2026-09-29 16:29-16:32, all 401 (bisected to ENTRYPOINT alone; the
# others are unset too because they belong to the same host-auth handshake).
unset CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SDK_HAS_HOST_AUTH_REFRESH \
      CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CODE_OAUTH_SCOPES
exec claude --model "$MODEL" "$@"
