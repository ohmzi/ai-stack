+		selectedFilterIds =
+			!off && mode === 'task'
+				? [...(selectedFilterIds ?? []).filter((id) => id !== TASK_FILTER_ID), TASK_FILTER_ID]
+				: (selectedFilterIds ?? []).filter((id) => id !== TASK_FILTER_ID);
